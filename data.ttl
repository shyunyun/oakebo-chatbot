    dm:groupName """자료"""@ko ;
    dm:remark """1997년 1월 23일 열린 미국 상원 에보닉스 청문회의 공식 기록으로, 윌리엄스와 잭슨의 서면 진술이 실려 있다. / 원문 표기: S. Hrg. 105-20 — EBONICS."""@ko ;
    schema:url <https://www.govinfo.gov/content/pkg/CHRG-105shrg39641/pdf/CHRG-105shrg39641.pdf> ;
    dm:dataset """oakebo""" ;
    dm:recorder """수현"""@ko ;
    dm:recordDate "2026-10-13"^^xsd:date .

dm:A00123 a dm:Person ;
    rdfs:label """제시 잭슨"""@ko ;
    dm:groupName """실존 인물"""@ko ;
    dm:remark """1941-2026, 미국의 민권운동가이자 목사로, 이 데이터셋 딜레마의 주체이다. / 원문 표기: Jesse Jackson."""@ko ;
    dm:dataset """oakebo""" ;
    dm:recorder """수현"""@ko ;
    dm:recordDate "2026-10-13"^^xsd:date .

dm:A00124 a dm:Organization ;
    rdfs:label """오클랜드 교육위원회"""@ko ;
    dm:groupName """실재 단체"""@ko ;
    dm:remark """오클랜드 교육구의 정책을 의결하는 교육위원회로, 에보닉스 결의안을 채택한 기관이다. / 원문 표기: Oakland Board of Education (OBE)."""@ko ;
    dm:dataset """oakebo""" ;
    dm:recorder """수현"""@ko ;
    dm:recordDate "2026-10-13"^^xsd:date .

dm:A00125 a dm:Organization ;
    rdfs:label """오클랜드 통합교육구"""@ko ;
    dm:groupName """실재 단체"""@ko ;
    dm:remark """캘리포니아주 오클랜드의 공립학교를 운영하는 교육구로, 결의안에 따른 정책을 실행하는 기관이다. / 원문 표기: Oakland Unified School District (OUSD)."""@ko ;
    dm:dataset """oakebo""" ;
    dm:recorder """수현"""@ko ;
    dm:recordDate "2026-10-13"^^xsd:date .

dm:A00126 a dm:Concept ;
    rdfs:label """에보닉스"""@ko ;
    dm:groupName """언어학 용어"""@ko ;
    dm:remark """ebony와 phonics를 합쳐 만든 말로, 1996년 Oakland 논쟁에서 아프리카계 미국인의 언어적 변이를 가리키는 핵심 용어로 사용되었다. / 원문 표기: Ebonics."""@ko ;
    dm:dataset """oakebo""" ;
    dm:recorder """수현"""@ko ;
    dm:recordDate "2026-10-13"^^xsd:date .

dm:A00127 a dm:Event ;
    rdfs:label """잭슨의 「미트 더 프레스」 결의안 비판"""@ko ;
    dm:groupName """실재 사건"""@ko ;
    dm:remark """1996년 12월 22일 NBC 「미트 더 프레스」에서 잭슨이 원 결의안을 공개적으로 비판한 일이다. / 원문 표기: Meet the Press."""@ko ;
    dm:dataset """oakebo""" ;
    dm:recorder """수현"""@ko ;
    dm:recordDate "2026-10-13"^^xsd:date .

dm:A00128 a dm:Dilemma ;
    rdfs:label """잭슨: 원 결의안을 바로 공개 비판할 것인가"""@ko ;
    dm:groupName """딜레마"""@ko ;
    dm:remark """정책의 취지를 확인하기 전에 공개 비판으로 표준 영어 교육의 중요성을 바로 주장할지' 혹은 '비판을 미루고 취지를 먼저 확인할지'라는 예상되는 선택지 중 잭슨이 실제로 내린 선택이다."""@ko ;
    dm:dataset """oakebo""" ;
    dm:recorder """수현"""@ko ;
    dm:recordDate "2026-10-15"^^xsd:date ;
    dm:note """작업자 해석: 12/22 공개 비판과 이후 입장 완화를 바탕으로 ‘즉시 공개 비판’과 ‘비판 유보·정책 취지 확인’을 두 선택지로 구성하였다. Jackson이 당시 두 선택지를 명시적으로 비교했다는 직접 기록은 확인되지 않았다."""@ko .

dm:A00129 a dm:Option ;
    rdfs:label """잭슨: 공개적으로 비판한다"""@ko ;
    dm:groupName """선택지"""@ko ;
    dm:remark """원 결의안의 문구를 곧바로 공개 비판하는 선택지이다. / 작업자 해석: 표준 영어 습득의 중요성을 즉시 주장할 수 있지만, 정책의 취지를 확인하지 못한 채 비판할 위험이 있다."""@ko ;
    dm:dataset """oakebo""" ;
    dm:recorder """수현"""@ko ;
    dm:recordDate "2026-10-13"^^xsd:date .

dm:A00130 a dm:Option ;
    rdfs:label """잭슨: 공개 비판을 유보한다"""@ko ;
    dm:groupName """선택지"""@ko ;
    dm:remark """정책의 취지를 확인할 때까지 공개 비판을 미루는 선택지이다. / 작업자 해석: 확인한 뒤 확실하게 비판할 수 있지만, 문제라고 본 표현을 즉시 비판하는 효과는 포기한다."""@ko ;
    dm:dataset """oakebo""" ;
    dm:recorder """수현"""@ko ;
    dm:recordDate "2026-10-13"^^xsd:date .

