dm:A00146 a dm:Claim ;
    rdfs:label """잭슨의 진술: 에보닉스는 언어가 아니라 언어 패턴이다"""@ko ;
    dm:groupName """주장"""@ko ;
    dm:remark """잭슨이 게트리지와 통화한 뒤 에보닉스를 언어가 아니라 언어 패턴이라고 말한 진술이다. 근거: 워싱턴 포스트 기사 24행. / 원문 표기: "a language pattern, not a language"."""@ko ;
    dm:dataset """oakebo""" ;
    dm:recorder """수현"""@ko ;
    dm:recordDate "2026-10-13"^^xsd:date .

dm:A00147 a dm:Claim ;
    rdfs:label """오클랜드 교육위원회의 주장: 아프리카 언어 체계는 영어의 방언이 아니다"""@ko ;
    dm:groupName """주장"""@ko ;
    dm:remark """원 결의안이 아프리카 언어 체계를 'genetically based'된 것이며 영어의 방언이 아니라고 규정한 문구를 주장으로 기록한 것이다. / 원문 표기: African Language Systems, "genetically based and not a dialect of English"."""@ko ;
    dm:dataset """oakebo""" ;
    dm:recorder """수현"""@ko ;
    dm:recordDate "2026-10-13"^^xsd:date .

