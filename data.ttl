    dm:remark """1930-2020, 1973년 1월 26일 세인트루이스 학술회의에서 에보닉스라는 말을 만든 미국의 심리학자이다. / 원문 표기: Robert L. Williams."""@ko ;
    dm:dataset """oakebo""" ;
    dm:recorder """수현"""@ko ;
    dm:recordDate "2026-10-13"^^xsd:date .

dm:A00122 a dm:Document ;
