@prefix dm:   <https://example.org/hb/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .

# 스키마
dm:Person a rdfs:Class ; rdfs:label "인물" .
dm:Object a rdfs:Class ; rdfs:label "사물" .
dm:hasBrother a rdf:Property ; rdfs:label "형제" ; rdfs:comment "두 인물이 형제 관계임" .
dm:receives a rdf:Property ; rdfs:label "받다" .
dm:remark a rdf:Property ; rdfs:label "설명" .
dm:GroupName a rdf:Property ; rdfs:label "구분" .

# 인스턴스
dm:A001 a dm:Person ; rdfs:label "흥보" ; dm:GroupName "등장인물" ;
    dm:remark "놀부의 동생. 가난하지만 다친 제비를 고쳐 준다." ;
    dm:hasBrother dm:A002 ; dm:receives dm:A003 .
dm:A002 a dm:Person ; rdfs:label "놀부" ; dm:GroupName "등장인물" ;
    dm:remark "흥보의 형. 부모의 재산을 혼자 차지한다." .
dm:A003 a dm:Object ; rdfs:label "박씨" ;
    dm:remark "제비가 은혜를 갚기 위해 물어 온 씨앗." .

# 관계(트리플)에 대한 설명
dm:T001 a rdf:Statement ; rdf:subject dm:A001 ; rdf:predicate dm:receives ; rdf:object dm:A003 ;
    dm:remark "다리를 고쳐 준 제비가 이듬해 봄에 가져옴." .
